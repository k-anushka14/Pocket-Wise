# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# CORS -- comma-separate multiple allowed origins, e.g. for local dev +
# your deployed frontend: http://localhost:5173,https://pocketwise.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# AI (Gemini) -- leave empty to disable AI features gracefully
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
